# Koneksi Postgres yang sudah jalan di EasyPanel — tinggal isi.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/sinyal_crm"

# Secret untuk sign session cookie login dashboard. WAJIB diganti,
# minimal 32 karakter acak. Generate: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Admin dashboard — dipakai sekali oleh `npm run db:seed` untuk membuat akun.
ADMIN_EMAIL="admin@domain.com"
ADMIN_PASSWORD="ganti-password-kuat"

# Samakan dengan WHATSAPP_WEBHOOK_SECRET di container Gowa (untuk verifikasi
# signature X-Hub-Signature-256). Boleh dikosongkan saat awal setup/testing,
# tapi WAJIB diisi sebelum live agar webhook tidak bisa dipalsukan orang lain.
GOWA_WEBHOOK_SECRET=""

# Prefix kode voucher SEKARANG diatur dari dashboard (Settings -> Konfigurasi
# Voucher, tersimpan di database), bukan di sini lagi. Var ini cuma dipakai
# SEKALI sebagai migrasi kalau Anda pernah pakai versi lama - kalau sudah ada
# baris AppSettings di database, var ini diabaikan sepenuhnya.
VOUCHER_PREFIXES="BT,RB,GM"

# true (default) = tangkap No HP walau voucher hilang/tak ketemu (orphan capture).
CAPTURE_NO_VOUCHER="true"

# Origin yang diizinkan memanggil POST /api/leads dari browser (snippet LP).
# "*" untuk izinkan semua domain, atau isi domain landing page Anda.
ALLOWED_ORIGIN="*"

# URL publik aplikasi ini (dipakai di halaman Settings untuk menampilkan
# webhook URL). Opsional — kalau kosong, dideteksi otomatis dari request host.
APP_URL=""

# Berapa hari Webhook Log disimpan sebelum otomatis dihapus (housekeeping,
# log ini cuma untuk debug jangka pendek, bukan sumber laporan).
WEBHOOK_LOG_RETENTION_DAYS="30"

# Setiap berapa menit pengiriman otomatis ke Meta CAPI & TikTok Events API
# berjalan di background (menu Export). Kredensial per destination diatur
# lewat UI Export, bukan env var - biar bisa multi-akun tanpa redeploy.
EXPORT_INTERVAL_MINUTES="15"
