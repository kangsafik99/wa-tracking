generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW_LEAD
  CONTACT
  FOLLOW_UP
  QUALIFIED_LEAD
  BOOKING
  PURCHASE
  CLOSED_LOST
}

enum LeadSource {
  LPWA // landing page -> WhatsApp (voucher bridge)
  CTWA // click-to-WhatsApp (Meta ad referral)
  GOOGLE_MAPS
  ORGANIC // captured with no attribution at all (orphan)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// Baris tunggal (id selalu "singleton") untuk pengaturan yang dulunya env var
// statis - dipindah ke database supaya bisa diedit dari Settings tanpa
// redeploy. Lihat src/lib/settings.ts.
model AppSettings {
  id              String   @id @default("singleton")
  voucherPrefixes String[] @default(["BT", "RB", "GM"])
  // Trafik organik (tanpa click ID sama sekali) tidak bisa dikirim balik jadi
  // sinyal purchase ke platform iklan (Ebook SINYAL 1.7), jadi monitoringnya
  // opsional - default disembunyikan dari Overview & Leads, bisa dinyalakan
  // di sini kalau mau dipantau juga.
  showOrganicTraffic Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model Lead {
  id          String     @id @default(cuid())
  voucherCode String?    @unique
  name        String?
  phone       String?
  email       String?
  totalValue  Decimal?   @db.Decimal(14, 2)
  status      LeadStatus @default(NEW_LEAD)
  source      LeadSource @default(LPWA)
  branch      String?

  // click IDs / attribution
  gclid      String?
  ttclid     String?
  fbclid     String?
  ctwaClid   String?
  externalId String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  fbc        String?
  fbp        String?

  eventTime DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@index([utmSource])
}

model WebhookLog {
  id        String   @id @default(cuid())
  source    String // "gowa"
  event     String? // "message", etc
  result    String? // short human-readable outcome, e.g. "linked:BT-XXXX"
  raw       Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum ExportPlatform {
  META
  TIKTOK
  GOOGLE
}

// Tujuan pengiriman konversi server-side (Ebook SINYAL Bagian 5). Dikelola dari
// dashboard (bukan env var statis) supaya siap multi-akun tanpa redeploy -
// klik ID bersifat account-scoped (Ebook 1.2), jadi tiap Ad Account/brand butuh
// destination sendiri, dipetakan lewat prefix voucher (Ebook 3.5, 5.2).
model ExportDestination {
  id       String         @id @default(cuid())
  name     String
  platform ExportPlatform
  active   Boolean        @default(true)

  // Lead di-route ke sini kalau voucherCode-nya diawali salah satu prefix ini.
  voucherPrefixes String[]
  // Fallback terakhir kalau tidak ada voucherPrefixes yang cocok.
  isDefault Boolean @default(false)

  // Meta CAPI
  metaDatasetId     String?
  metaAccessToken   String?
  metaTestEventCode String?

  // TikTok Events API
  tiktokPixelCode    String?
  tiktokAccessToken  String?
  tiktokTestEventCode String?

  // Google Ads API (OAuth) - Client ID/Secret dari Google Cloud Console (satu
  // project OAuth bisa dipakai untuk banyak destination). Developer Token dari
  // Google Ads API Center. refreshToken didapat otomatis lewat alur "Connect
  // Google Ads" (src/app/api/oauth/google), bukan diisi manual.
  googleClientId         String?
  googleClientSecret     String?
  googleDeveloperToken   String?
  googleRefreshToken     String?
  googleCustomerId       String? // ID akun Google Ads tujuan (10 digit, tanpa strip)
  googleLoginCustomerId  String? // ID akun manager/MCC, opsional (kalau customerId dikelola lewat MCC)
  // Resource name Conversion Action per status, mis.
  // {"CONTACT": "customers/1234567890/conversionActions/987654321"}.
  // Conversion Action-nya harus sudah dibuat duluan di Google Ads UI (Ebook 5.2).
  googleConversionActions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs ExportLog[]

  @@index([platform])
}

// Audit trail pengiriman - setara "Meta Sync Log" di ebook, sekaligus dipakai
// untuk dedup (jangan kirim event yang sama dua kali ke destination yang sama).
model ExportLog {
  id            String            @id @default(cuid())
  destinationId String
  destination   ExportDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  leadId        String
  eventName     String
  status        String // "success" | "error"
  responseBody  String?
  createdAt     DateTime          @default(now())

  @@index([destinationId, leadId, eventName])
  @@index([createdAt])
}
